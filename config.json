{
  "app": {
    "name": "fal-processor",
    "auto_start": false,
    "idle_poll_seconds": 1
  },

  "paths": {
    "source_dir": "${SOURCE_DIR:-/data/source}",
    "staging_dir": "${STAGING_DIR:-/data/staging}",
    "results_dir": "${RESULTS_DIR:-/data/results}",
    "archive_dir": "${ARCHIVE_DIR:-/data/archive}"
  },

  "source": {
    "file_glob": "*.txt",
    "min_age_seconds": 0
  },

  "rename": {
    "pattern": "^(?P<name>.+)\\.txt$",
    "replacement": "FAL_{job_id}_\\g<name>.txt",
    "on_no_match": "keep_name",
    "on_target_exists": "error"
  },

  "staging": {
    "use_temp_suffix": true,
    "temp_suffix": ".part"
  },

  "soap": {
    "wsdl_url": "http://cbs-host/BIService?wsdl",
    "endpoint_url": "http://cbs-host/BIService",
    "namespace": "http://www.huawei.com/bme/cbsinterface/cbsbatchprovision",
    "namespace_prefix": "cbs",
    "service_name": "BatchProvisionService",
    "port_name": "BatchProvisionPort",
    "request_message": "BatchScatteredChgSubBasicInfoRequestMsg",
    "request_element": "BatchScatteredChgSubBasicInfoRequest",
    "request_header": {
      "Version": "1.0",
      "BusinessCode": "CHGSCATTEREDACCT",
      "MessageSeq": "{{message_seq}}",
      "BEID": "BEID_001",
      "LoginSystemCode": "FAL_PROCESSOR",
      "Password": "changeme",
      "OperatorID": "SYS_OP"
    },
    "envelope_template": "<?xml version=\"1.0\" encoding=\"utf-8\"?><soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:cbs=\"http://www.huawei.com/bme/cbsinterface/cbsbatchprovision\"><soap:Header><cbs:RequestHeader><cbs:Version>{{Version}}</cbs:Version><cbs:BusinessCode>{{BusinessCode}}</cbs:BusinessCode><cbs:MessageSeq>{{MessageSeq}}</cbs:MessageSeq><cbs:BEID>{{BEID}}</cbs:BEID><cbs:LoginSystemCode>{{LoginSystemCode}}</cbs:LoginSystemCode><cbs:Password>{{Password}}</cbs:Password><cbs:OperatorID>{{OperatorID}}</cbs:OperatorID></cbs:RequestHeader></soap:Header><soap:Body><cbs:BatchScatteredChgSubBasicInfoRequestMsg><cbs:BatchScatteredChgSubBasicInfoRequest><cbs:FileName>{{file_name}}</cbs:FileName></cbs:BatchScatteredChgSubBasicInfoRequest></cbs:BatchScatteredChgSubBasicInfoRequestMsg></soap:Body></soap:Envelope>",
    "extra_params_from_db": false,

    "initial_delay_seconds": 60,
    "retry_interval_seconds": 15,
    "max_wait_seconds": 900,
    "max_attempts": 0,
    "retry_on_transport_error": true,
    "retry_on_fault": false,

    "not_found_patterns": [
      "file does not exist",
      "file not found",
      "no such file",
      "file doesn't exist"
    ],
    "success_patterns": [
      "<cbs:ResultCode>0</cbs:ResultCode>",
      "ResultCode>0<",
      "Operation successfully"
    ],

    "record_errors_in_db": true,
    "response_excerpt_chars": 2000
  },

  "results": {
    "wait_timeout_seconds": 3600,
    "poll_interval_seconds": 5,
    "stable_seconds": 2,
    "files": [
      { "name": "summary", "glob": "{stem}*_summary*", "required": false, "check_status": true },
      { "name": "detail",  "glob": "{stem}*_detail*",  "required": false, "check_status": false },
      { "name": "failed",  "glob": "{stem}*_FAILED.msg", "required": false, "check_status": false, "delimiter": "|", "columns": ["account_id", "operation_type", "segment_info", "error_code", "error_message"] }
    ],
    "encoding": "utf-8",
    "encoding_errors": "replace",
    "skip_blank_lines": true,
    "delimiter": "",
    "parse_json_lines": false,
    "success_regex": "(?i)(success|completed|ResultCode>0<)",
    "failure_regex": "(?i)\\b(fail|failed|failure|error)\\b",
    "log_preview_lines": 5,
    "log_preview_max_chars": 300,
    "after_import": "keep"
  },

  "processing": {
    "on_job_failure": "continue",
    "retry_failed_on_resume": true
  },

  "database": {
    "host": "${DB_HOST:-postgres}",
    "port": "${DB_PORT:-5432}",
    "dbname": "${DB_NAME:-fal_db}",
    "user": "${DB_USER:-fal_user}",
    "password": "${DB_PASSWORD:-fal_password}",
    "sslmode": "prefer",
    "connect_timeout": 10,
    "max_retries": 5,
    "retry_delay_seconds": 3,
    "schema": "public",
    "auto_create_tables": true,
    "tables": {
      "runs": "process_runs",
      "jobs": "file_jobs",
      "soap_errors": "soap_call_errors",
      "results": "result_records",
      "json_config": "json_config"
    },
    "json_config": {
      "key_column": "config_key",
      "value_column": "config_value"
    }
  },

  "redis": {
    "host": "${REDIS_HOST:-redis}",
    "port": "${REDIS_PORT:-6379}",
    "db": 0,
    "socket_timeout_seconds": 5,
    "reconnect_delay_seconds": 3,
    "retain_last_values": true,
    "channels": {
      "control": "fal:control",
      "logs": "fal:logs",
      "status": "fal:status",
      "progress": "fal:progress"
    }
  },

  "logging": {
    "level": "INFO",
    "console": true,
    "file": "logs/fal_processor.log",
    "max_bytes": 10485760,
    "backup_count": 5,
    "publish_to_redis": true
  }
}
