{
  "app": {
    "name": "fal-processor",
    "auto_start": false,
    "idle_poll_seconds": 1
  },
  "paths": {
    "source_dir": "${SOURCE_DIR:-/data/source}",
    "staging_dir": "${STAGING_DIR:-/data/staging}",
    "results_dir": "${RESULTS_DIR:-/data/results}",
    "archive_dir": "${ARCHIVE_DIR:-/data/archive}"
  },
  "source": {
    "file_glob": "*.txt",
    "min_age_seconds": 0
  },
  "rename": {
    "pattern": "^(?P<name>.+)\\.(?:txt|msg)$",
    "replacement": "SCATTEREDCHGSUBINFO_{datetime}_{job_id}.msg",
    "on_no_match": "fail",
    "on_target_exists": "error"
  },
  "staging": {
    "use_temp_suffix": true,
    "temp_suffix": ".part"
  },
  "soap": {
    "endpoint_url": "${SOAP_URL:-http://host.docker.internal:8080/FalService}",
    "soap_version": "1.1",
    "soap_action": "${SOAP_ACTION:-}",
    "timeout_seconds": 60,
    "verify_ssl": true,
    "headers": {},
    "auth": {
      "type": "none",
      "username": "",
      "password": "",
      "token": ""
    },
    "envelope_template": "<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:bcs=\"http://www.huawei.com/bme/cbsinterface/bcservices\" xmlns:cbs=\"http://www.huawei.com/bme/cbsinterface/cbscommon\"> \n   <soapenv:Header/> \n   <soapenv:Body> \n      <bcs:BatchScatteredChgSubBasicInfoRequestMsg> \n         <RequestHeader> \n            <cbs:Version>{{version}}</cbs:Version> \n            <cbs:BusinessCode>BatchScatteredChgSubBasicInfo</cbs:BusinessCode> \n            <cbs:MessageSeq>{{message_seq}}</cbs:MessageSeq> \n            <cbs:OwnershipInfo> \n               <cbs:BEID>{{beid}}</cbs:BEID> \n            </cbs:OwnershipInfo> \n            <cbs:AccessSecurity> \n               <cbs:LoginSystemCode>{{login_system_code}}</cbs:LoginSystemCode> \n               <cbs:Password>{{password}}</cbs:Password> \n            </cbs:AccessSecurity> \n            <cbs:OperatorInfo> \n               <cbs:OperatorID>{{operator_id}}</cbs:OperatorID> \n            </cbs:OperatorInfo> \n         </RequestHeader> \n         <BatchScatteredChgSubBasicInfoRequest> \n            <bcs:FileName>{{file_name}}</bcs:FileName> \n         </BatchScatteredChgSubBasicInfoRequest> \n      </bcs:BatchScatteredChgSubBasicInfoRequestMsg> \n   </soapenv:Body> \n</soapenv:Envelope>",
    "extra_params_from_db": false,
    "initial_delay_seconds": 60,
    "retry_interval_seconds": 15,
    "max_wait_seconds": 900,
    "max_attempts": 0,
    "retry_on_transport_error": true,
    "retry_on_fault": false,
    "not_found_patterns": [
      "file does not exist",
      "file not found",
      "no such file",
      "file doesn't exist"
    ],
    "success_patterns": [],
    "record_errors_in_db": true,
    "response_excerpt_chars": 2000,
    "params": {
      "version": "1",
      "beid": "${SOAP_BEID:-101}",
      "login_system_code": "${SOAP_LOGIN_SYSTEM_CODE:-102}",
      "password": "${SOAP_PASSWORD}",
      "operator_id": "${SOAP_OPERATOR_ID:-101}"
    },
    "result_code_path": "./{http://www.huawei.com/bme/cbsinterface/bcservices}BatchScatteredChgSubBasicInfoResultMsg/ResultHeader/{http://www.huawei.com/bme/cbsinterface/cbscommon}ResultCode",
    "result_desc_path": "./{http://www.huawei.com/bme/cbsinterface/bcservices}BatchScatteredChgSubBasicInfoResultMsg/ResultHeader/{http://www.huawei.com/bme/cbsinterface/cbscommon}ResultDesc",
    "success_codes": [
      "0"
    ]
  },
  "results": {
    "wait_timeout_seconds": 3600,
    "poll_interval_seconds": 5,
    "stable_seconds": 2,
    "files": [
      {
        "name": "summary",
        "glob": "{stem}_SUMMERY.msg",
        "required": true,
        "check_status": true
      },
      {
        "name": "success",
        "glob": "{stem}_SUCC.msg",
        "required": true,
        "check_status": false
      },
      {
        "name": "failed",
        "glob": "{stem}_FAILED.msg",
        "required": true,
        "check_status": false,
        "fail_if_nonempty": true
      }
    ],
    "encoding": "utf-8",
    "encoding_errors": "replace",
    "skip_blank_lines": true,
    "delimiter": "",
    "parse_json_lines": false,
    "success_regex": "(?i)\\bsuccess\\b",
    "failure_regex": "(?i)\\b(fail|failed|failure)\\b",
    "log_preview_lines": 5,
    "log_preview_max_chars": 300,
    "after_import": "keep"
  },
  "processing": {
    "on_job_failure": "continue",
    "retry_failed_on_resume": true
  },
  "database": {
    "host": "${DB_HOST:-postgres}",
    "port": "${DB_PORT:-5432}",
    "dbname": "${DB_NAME:-fal_db}",
    "user": "${DB_USER:-fal_user}",
    "password": "${DB_PASSWORD:-fal_password}",
    "sslmode": "prefer",
    "connect_timeout": 10,
    "max_retries": 5,
    "retry_delay_seconds": 3,
    "schema": "public",
    "auto_create_tables": true,
    "tables": {
      "runs": "process_runs",
      "jobs": "file_jobs",
      "soap_errors": "soap_call_errors",
      "results": "result_records",
      "json_config": "json_config"
    },
    "json_config": {
      "key_column": "config_key",
      "value_column": "config_value"
    }
  },
  "redis": {
    "host": "${REDIS_HOST:-redis}",
    "port": "${REDIS_PORT:-6379}",
    "db": 0,
    "password": "${REDIS_PASSWORD:-}",
    "socket_timeout_seconds": 5,
    "reconnect_delay_seconds": 3,
    "retain_last_values": true,
    "channels": {
      "control": "fal:control",
      "logs": "fal:logs",
      "status": "fal:status",
      "progress": "fal:progress"
    }
  },
  "logging": {
    "level": "INFO",
    "console": true,
    "file": "logs/fal_processor.log",
    "max_bytes": 10485760,
    "backup_count": 5,
    "publish_to_redis": true
  }
}
